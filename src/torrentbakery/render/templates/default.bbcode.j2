{% if images.cover %}
[center]{% if links.get("cover") %}[url={{ links.cover }}]{% endif %}[img]{{ images.cover }}[/img]{% if links.get("cover") %}[/url]{% endif %}[/center]

{% endif %}
[center][size=5][b]{{ release.title }}[/b][/size][/center]

{% if release.studio %}[b]Studio:[/b] {{ release.studio }}
{% endif %}
{% if release.date %}[b]Released:[/b] {{ release.date }}
{% endif %}
{% if release.performers %}[b]Performers:[/b] {{ release.performers | join(", ") }}
{% endif %}
{% if release.tags %}[b]Tags:[/b] {{ release.tags | map("lower") | join(", ") }}
{% endif %}

{% if release.description %}
[quote]{{ release.description }}[/quote]

{% endif %}
[b]File[/b]
[b]Name:[/b] {{ info.filename }}
[b]Size:[/b] {{ info.size | filesize }}
[b]Duration:[/b] {{ info.duration | duration }}
[b]Video:[/b] {{ info.video_codec | codec }}, {{ info.width }}x{{ info.height }}, {{ "%g" | format(info.fps) }} fps{% if info.video_bitrate %}, {{ info.video_bitrate // 1000 }} kb/s{% endif %}

{% for a in info.audio %}
[b]Audio:[/b] {{ a.codec | codec }}, {{ a.channels }} ch{% if a.language | language %}, {{ a.language | language }}{% endif %}

{% endfor %}
{% if info.bitrate %}
[b]Overall bit rate:[/b] {{ info.bitrate // 1000 }} kb/s
{% endif %}

{% if images.sheet %}
[center]{% if links.get("sheet") %}[url={{ links.sheet }}]{% endif %}[img]{{ images.sheet }}[/img]{% if links.get("sheet") %}[/url]{% endif %}[/center]

{% endif %}
{% if info.full_text %}
[spoiler=MediaInfo][code]{{ info.full_text }}[/code][/spoiler]
{% endif %}
{% for u in release.urls %}
{% if loop.first %}
[b]Links[/b]
{% endif %}
[url]{{ u }}[/url]
{% endfor %}
