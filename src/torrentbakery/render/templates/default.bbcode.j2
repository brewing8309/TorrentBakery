{% if images.cover %}
[center][img]{{ images.cover }}[/img][/center]

{% endif %}
[center][size=5][b]{{ release.title }}[/b][/size][/center]

{% if release.studio %}[b]Studio:[/b] {{ release.studio }}
{% endif %}
{% if release.date %}[b]Released:[/b] {{ release.date }}
{% endif %}
{% if release.performers %}[b]Performers:[/b] {{ release.performers | join(", ") }}
{% endif %}
{% if release.tags %}[b]Tags:[/b] {{ release.tags | join(", ") }}
{% endif %}

{% if release.description %}
[quote]{{ release.description }}[/quote]

{% endif %}
[b]File[/b]
[list]
[*]Name: {{ info.filename }}
[*]Size: {{ info.size | filesize }}
[*]Duration: {{ info.duration | duration }}
[*]Video: {{ info.video_codec }}, {{ info.width }}x{{ info.height }}, {{ "%g" | format(info.fps) }} fps{% if info.video_bitrate %}, {{ info.video_bitrate // 1000 }} kb/s{% endif %}

{% for a in info.audio %}
[*]Audio: {{ a.codec }}, {{ a.channels }} ch{% if a.language %}, {{ a.language }}{% endif %}

{% endfor %}
[/list]

{% if images.sheet %}
[center][img]{{ images.sheet }}[/img][/center]

{% endif %}
{% if info.full_text %}
[spoiler=MediaInfo][code]{{ info.full_text }}[/code][/spoiler]
{% endif %}
{% for u in release.urls %}
{% if loop.first %}
[b]Links[/b]
{% endif %}
[url]{{ u }}[/url]
{% endfor %}
